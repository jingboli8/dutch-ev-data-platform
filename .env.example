# Copy to .env to override config/settings.toml.
# Keep this file untracked: the hash salt must be secret and stable.
EV_SNAPSHOT_LIMIT=10000
EV_REQUEST_TIMEOUT_SECONDS=30
EV_API_PAGE_SIZE=1000
EV_DETAIL_BATCH_SIZE=200
EV_DATA_DIR=data
EV_DATABASE_PATH=data/warehouse/dutch_ev.duckdb
EV_STATE_DIR=.state
EV_LOG_LEVEL=INFO
# EV_HASH_SALT=replace-with-a-long-random-secret

# Optional dbt override; defaults to the repository-local DuckDB warehouse.
# DBT_DUCKDB_PATH=data/warehouse/dutch_ev.duckdb
