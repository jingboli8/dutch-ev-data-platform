# Copy to .env to override config/settings.toml.
# Keep this file untracked: the hash salt must be secret and stable.
EV_SAMPLE_LIMIT=500
EV_REQUEST_TIMEOUT_SECONDS=30
EV_API_PAGE_SIZE=1000
EV_DATA_DIR=data
EV_DATABASE_PATH=data/warehouse/dutch_ev.duckdb
EV_LOG_LEVEL=INFO
